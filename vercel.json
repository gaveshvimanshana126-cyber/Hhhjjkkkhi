{
  "regions": ["sin1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/baner.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/pwa.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/ad-slots.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/ads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/movie.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.*-sinhala-subtitles)"
        }
      ],
      "destination": "/movie/:id",
      "permanent": true
    },
    {
      "source": "/tv.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.*-sinhala-subtitles)"
        }
      ],
      "destination": "/tv/:id",
      "permanent": true
    },
    {
      "source": "/movie.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.*)"
        }
      ],
      "destination": "/movie/:id-sinhala-subtitles",
      "permanent": true
    },
    {
      "source": "/tv.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.*)"
        }
      ],
      "destination": "/tv/:id-sinhala-subtitles",
      "permanent": true
    },
    {
      "source": "/seris/:id(.*-sinhala-subtitles)",
      "destination": "/tv/:id",
      "permanent": true
    },
    {
      "source": "/seris/:id",
      "destination": "/tv/:id-sinhala-subtitles",
      "permanent": true
    }
  ],
  "rewrites": [
